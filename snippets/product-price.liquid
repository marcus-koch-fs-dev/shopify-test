<link rel="stylesheet" href="{{ 'product-price.css' | asset_url }}">

<!-- Price Section -->
<div class="price-energy">
  <div class="price">
    <h5 class="price__regular">699,99€</h5>
    <div class="discount">
      <h3 class="discount__price">199,99€</h3>
      <span class="discount__offer">-35%</span>
    </div>
    <div class="tax">
      <span class="tax__price">355€</span>
      <span class="tax__info">&nbsp;inkl. Mwst, zzgl. Versand</span>
    </div>
  </div>
  {% if section.settings.show_energy_label %}
    <div class="energy">
      <div class="wrapper">
        <div class="energy-label">
          <img
            src="{{ product.metafields.custom.energy_label | image_url }}"
            alt="Energy Efficiency Label"
            width="100%"
            height="auto">
        </div>
        <a
          href="https://www.google.com/"
          download="example.pdf"
          target="_blank"
          rel="noopener noreferrer">
          <span class="energy-label__text">{{ section.settings.energy_label_text }}</span>
        </a>
      </div>
    </div>
  {% endif %}
</div>