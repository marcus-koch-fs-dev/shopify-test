<link rel="stylesheet" href="{{ 'product-info.css' | asset_url }}">

{% comment %}
  Usage: {% render 'product-info',
  is_atc-bar: section.settings.is_atc-bar,
  rating_stars: section.settings.rating_stars,
  show_art-no: section.settings.show_art-no,
  show-favorite: section.settings.show-favorite,
  isFav: section.settings.isFav,
  titel: section.settings.titel,
  offensive_title: section.settings.offensive_title,
  show_brand: section.settings.show_brand %}
{% endcomment %}


<!-- Ratings and Product Information -->
<div class="product-info">
  {% if section.settings.is_atc-bar %}
    <div class="atc-box">
      <p>
        <span class="product-name__vendor">{{ product.vendor }}</span>
      </p>
      <p>
        <span class="product-name__title">Dito Sama Prep4You</span>
      </p>
    </div>
  {% endif %}
  <!-- Row 1 -->
  <div class="product-info__row-one">
    <div class="product-info__web-view">
      <div class="rating">
        {% assign stars = section.settings.rating_stars | plus: 0 %}
        {% if stars >= 1 and stars <= 5 %}
          {% for i in (1..stars) %}
            <span class="rating__star">&#9733;</span>
          <!-- Gefüllter Stern -->
            {% comment %} <span class="star">&#9734;</span> <!-- Ungefüllter Stern --> {% endcomment %}
          {% endfor %}
        {% endif %}
        <span class="rating__feedback">(89)</span>
      </div>

      <div class="product-artno">
        {% if section.settings.show_art-no %}
          <span class="product-artno__text">Art.-Nr.: GH-650210</span>
        {% endif %}
      </div>
    </div>
    {% if section.settings.show-favorite %}
      <div class="favorite">
        <svg
          class="favorite__icon"
          width="auto"
          height="auto"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 22C12 22 22.5 14.5749 22.5 7.54815C22.5 0.521375 13.184 -0.0194266 12 7.00826C10.816 -0.0194266 1.5 0.521375 1.5 8.08895C1.5 15.6565 12 22 12 22Z"
            stroke="#0A1119"
            stroke-width="1.75"
            stroke-linejoin="round" />
        </svg>
      </div>
    {% endif %}
  </div>

  <!-- Row 2 -->
  {% if section.settings.is_atc-bar == false %}
    <div class="product-name">
      {% if section.settings.bold-title %}
        <h5 class="product-name__title">{{ product.title }}</h5>
      {% else %}
        <span class="product-name__title">{{ product.title }}</span>
      {% endif %}
    </div>
  {% endif %}


  {% if section.settings.show_brand-logo %}
    <div class="brand">
      <img
        class="brand__logo"
        src="{{ product.metafields.custom.brand_logo | image_url }}"
        alt="Brand Logo"
        width="auto"
        height="auto">
    </div>
  {% endif %}
</div>