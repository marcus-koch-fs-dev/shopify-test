<link rel="stylesheet" href="{{ 'product-options.css' | asset_url }}">
<script src="{{ 'product-options.js' | asset_url }}" defer></script>

<!-- Variants Section -->
{% if section.settings.show-variations %}
  <div class="product-variants">
    <div class="product-variants__selected">
      <span class="product-variants__category">Capacity:</span>
      <span class="product-variants__option">{{ product.variants[0].title }}</span>
    </div>

    <ul class="product-variants__list">

      <!-- Fake -->
      <li class="product-variants__item variant--selected">
        <span class="variant__title">{{ product.variants[0].title }}</span>
      </li>
      <li class="product-variants__item">
        <span class="variant__title">{{ product.variants[1].title }}</span>
      </li>
      <li class="product-variants__item variant--out">
        <span class="variant__title">{{ product.variants[2].title }}</span>
      </li>

    </ul>
  </div>
{% endif %}


{% comment %} {% for variant in product.variants %}
    <li class="product-variants__item variant {% if variant.inventory_quantity <= 0 %}variant--out{% endif %}">
      <span class="variant__title" onclick="handleVariant('{{ variant.id }}')">{{ variant.title }}</span>
    </li>
{% endfor %} {% endcomment %}