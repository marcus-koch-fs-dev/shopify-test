<link rel="stylesheet" href="{{ 'drawer.css' | asset_url }}">

<div
  class="drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="drawer-title"
  tabindex="-1">
  <div class="drawer-content">
    <button
      class="drawer-close"
      aria-label="Close drawer"
      type="button">
      <span aria-hidden="true">X</span>
    </button>
    <h2 id="drawer-title" class="visually-hidden">Drawer Content</h2>
    <div class="drawer-text"></div>
  </div>
</div>