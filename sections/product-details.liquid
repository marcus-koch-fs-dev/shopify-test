<link rel="stylesheet" href={{"product-details.css"| asset_url }}>
<script src={{"product-details.js"| asset_url }} defer="defer" />

<section class="product-details">
  <!-- Left Section: Image Gallery -->
  <div class="image-gallery">
    {% assign orientation = section.settings.orientation %}
    {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
    {% if orientation %}
      <div class="image-list--horizontal">
        {% render 'product-media-gallery'
          , variant_images: variant_images %}
        <ul>
          <li></li>
          <li></li>
          <li></li>
        </ul>
      </div>
    {% else %}
      <div class="image-list--vertical">
        <ul>
          <li></li>
          <li></li>
          <li></li>
        </ul>
        {% render 'product-media-gallery'
          , variant_images: variant_images %}
      </div>
    {% endif %}
  </div>

  <!-- Right Section: Product Details -->
  <div class="buybox">

    <!-- Highlights -->
    <div class="highlights">
      {% if section.settings.express %}
        <p class="highlights--express">Expressversand</p>
      {% endif %}
      {% if section.settings.discountOffer %}
        <p class="highlights--discount">Sonderangebot</p>
      {% endif %}
    </div>

    <!-- Ratings and Product Information -->
    <div class="product-info">
      <div class="ratings">
        <div class="rating-stars">
          {% assign stars = section.settings.rating_stars | plus: 0 %}
          {% if stars >= 1 and stars <= 5 %}
            {% for i in (1..stars) %}
              <img
                src="{{ 'icon-star.svg' | asset_url }}"
                alt="Rating Star"
                width="12"
                height="12">
            {% endfor %}
          {% endif %}

        </div>
        <span class="rating-quantity">({{ section.settings.feedbackNo }})</span>
        <span class="rating-artNo">Article No.: {{ section.settings.artNo }}</span>
        <div class="product-name">
          <h5>{{ section.settings.titel }}</h5>
        </div>
        <div class="brand">
          <img
            src="{{ section.settings.brand_logo | image_url }}"
            alt="Brand Logo"
            width="100%"
            height="auto">
        </div>
        <p class="description">
          {{ section.settings.prodDescription }}
        </p>
      </div>
    </div>

    <!-- Variants Section -->
    <div class="product-variants">
      <div class="current-selected">
        <span>Capacity: {{ section.settings.selected }}</span>
      </div>
      <div class="variants">
        <button>1000ml</button>
        <button>2000ml</button>
        <button>3000ml</button>
      </div>
    </div>

    <!-- Price Section -->
    <div class="price">
      <div class="normal-price"></div>
      <div class="discount-price">
        <span>199,99€</span>
        <span>-35%</span>
      </div>
      <div class="add-tax">
        <span>355€</span>
        <p>inkl. Mwst, zzgl. Versand</p>
      </div>
      {% if section.settings.show_energy_label %}
        <div class="energy-label">
          <img
            src="{{ section.settings.energy_label | image_url }}"
            alt="Energy Efficiency Label"
            width="100%"
            height="auto">
          <span>{{ section.settings.product_datasheet_label }}</span>
        </div>
      {% endif %}
    </div>

    <!-- Cart Actions -->
    <div class="cart-action">
      <form action="" method="post">
        <div class="product-counter">
          <button type="button" class="product-counter--decrease">
            <img
              src="{{ 'icon-minus.svg' | asset_url }}"
              alt="Decrease"
              width="24"
              height="24">
          </button>
          <span class="product-counter--cart">{{ section.settings.quantity }}</span>
          <button type="button" class="product-counter--increase">
            <img
              src="{{ 'icon-plus.svg' | asset_url }}"
              alt="Increase"
              width="24"
              height="24">
          </button>
        </div>
        <button type="submit" class="cart-action--submit">
          <img
            src="{{ 'icon-cart.svg' | asset_url }}"
            alt="Cart"
            width="24"
            height="24">
          <span>In den Warenkorb</span>
        </button>
        <button type="button" class="cart-action--wishlist">
          <img
            src="{{ 'icon-heart.svg' | asset_url }}"
            alt="Wishlist"
            width="24"
            height="24">
        </button>
      </form>
    </div>

    <!-- Delivery and Retour -->
    <div class="delivery-retour">
      <p class="delivery-retour--text"></p>
      <div class="deliver-time">
        <img
          src="{{ 'icon-tick.svg' | asset_url }}"
          alt="Wishlist"
          width="24"
          height="24">
        <p>Lieferbar in 3 Tagen</p>
        <img
          src="{{ 'icon-arrow.svg' | asset_url }}"
          alt="Wishlist"
          width="24"
          height="24">
      </div>
      <div class="deliver-cost">
        <img
          src="{{ 'icon-truck.svg' | asset_url }}"
          alt="Wishlist"
          width="24"
          height="24">
        <p>Kostenloser Versand</p>
        <img
          src="{{ 'icon-arrow.svg' | asset_url }}"
          alt="Wishlist"
          width="24"
          height="24">
      </div>
      <div class="deliver-time">
        <img
          src="{{ 'icon-return.svg' | asset_url }}"
          alt="Wishlist"
          width="24"
          height="24">
        <p>14 Tage Rückgabeservice</p>
        <img
          src="{{ 'icon-arrow.svg' | asset_url }}"
          alt="Wishlist"
          width="24"
          height="24">
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Product Details",
    "blocks": [],
    "presets": [
      {
        "name": "Default Product Details"
      }
    ],
    "settings": [
      {
        "type": "checkbox",
        "id": "discountOffer",
        "label": "Enable Discount Display",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "express",
        "label": "Enable Express Delivery",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "orientation",
        "label": "Horizontal Image Orientation",
        "default": false
      },
      {
        "type": "text",
        "id": "rating_stars",
        "label": "Star Rating (1-5)",
        "default": "5"
      },
      {
        "type": "text",
        "id": "feedbackNo",
        "label": "Feedback Count",
        "default": "89"
      },
      {
        "type": "text",
        "id": "artNo",
        "label": "Article Number",
        "default": "GH-3434"
      },
      {
        "type": "text",
        "id": "titel",
        "label": "Product Title",
        "default": "Default Title"
      },
      {
        "type": "image_picker",
        "id": "brand_logo",
        "label": "Brand Logo"
      },
      {
        "type": "textarea",
        "id": "prodDescription",
        "label": "Product Description",
        "default": "Default description for the product."
      },
      {
        "type": "text",
        "id": "selected",
        "label": "Selected Capacity",
        "default": "1000ml"
      },
      {
        "type": "number",
        "id": "quantity",
        "label": "Default Quantity",
        "default": 1

      },
      {
        "type": "checkbox",
        "id": "show_energy_label",
        "label": "Show Energy Label",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "energy_label",
        "label": "Energy Label Image"
      },
      {
        "type": "text",
        "id": "product_datasheet_label",
        "label": "Datasheet Label",
        "default": "Energy Efficiency Datasheet"
      }
    ]
  }
{% endschema %}