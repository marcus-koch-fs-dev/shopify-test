<link rel="stylesheet" href="{{ 'product-details.css' | asset_url }}">
<script src="{{ 'product-details.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-transport.js' | asset_url }}" defer="defer"></script>

<section class="product-details">

  {% render 'drawer' %}
  <!-- Left Section -->
  <div class="gallery">
    {% render 'product-gallery' %}
  </div>

  <!-- Right Section -->
  <div class="user-action">
    <div class="buybox">
      <div class="buybox__highlights">
        {% render 'product-highlights'
          , discountOffer: section.settings.discountOffer
          , express: section.settings.express
        %}
      </div>
      <div class="buybox__product-info">
        {% render 'product-info'
          , rating_stars: section.settings.rating_stars 
          , show_art-no: section.settings.show_art-no
          , show-favorite: section.settings.show-favorite 
          , offensive_title: section.settings.bold-title
          , show_brand: section.settings.show_brand-logo
        %}
      </div>
      <div class="buybox__description">
        {% render 'product-description' %}
      </div>
      <div class="buybox__product-options">
        {% render 'product-options'
          , rating_stars: section.settings.show-variations
        %}
      </div>
      <div class="buybox__product-price">
        {% render 'product-price'
          , rating_stars: section.settings.show_energy_label
          , discountOffer: section.settings.discountOffer
        %}
      </div>
      <div class="buybox__product-cart">
        {% render 'product-cart'
          , out-of-stock: section.settings.out-of-stock %}
      </div>
      <div class="buybox__product-transport">
        {% render 'product-transport'
          , express: section.settings.express
          , out-of-stock: section.settings.out-of-stock %}
      </div>
    </div>
    <div class="payments-wrapper">
      {% render 'payments' %}
    </div>
    <div class="service-options">
      {% render 'service-options' %}
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Product Details",
    "blocks": [],
    "presets": [
      {
        "name": "Product Details"
      }
    ],
    "settings": [
      {
        "type": "checkbox",
        "id": "discountOffer",
        "label": "Enable Discount",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "express",
        "label": "Enable Express",
        "default": true
      },
      {
        "type": "text",
        "id": "rating_stars",
        "label": "Rating Stars",
        "default": "5"
      },
      {
        "type": "checkbox",
        "id": "show_art-no",
        "label": "Show Article Number",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show-favorite",
        "label": "Show Favorite Icon",
        "default": true
      },
      {
        "type": "text",
        "id": "titel",
        "label": "Product Title",
        "default": "Default Product Name"
      },
      {
        "type": "checkbox",
        "id": "bold-title",
        "label": "Show Bold Product Title",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_brand-logo",
        "label": "Show Brand Logo",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show-variations",
        "label": "Product Variations",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_energy_label",
        "label": "Show Energy Label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "out-of-stock",
        "label": "Product is out of stock",
        "default": false
      }
    ]
  }
{% endschema %}