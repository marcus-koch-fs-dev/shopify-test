<link rel="stylesheet" href="{{ 'product-details.css' | asset_url }}">
<script src="{{ 'product-details.js' | asset_url }}" defer="defer"></script>


<section class="product-details">
  <!-- Left Section: Image Gallery -->
  <div class="image-gallery">
    {% assign orientation = section.settings.orientation %}
    {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
    {% if orientation %}
      <div class="image-list--horizontal">
        {% render 'product-media-gallery'
          , variant_images: variant_images %}
        <ul>
          <li></li>
          <li></li>
          <li></li>
        </ul>
      </div>
    {% else %}
      <div class="image-list--vertical">
        <ul>
          <li></li>
          <li></li>
          <li></li>
        </ul>
        {% render 'product-media-gallery'
          , variant_images: variant_images %}
      </div>
    {% endif %}
  </div>

  <!-- Right Section: Product Details -->
  <div class="buybox">
    <!-- Highlights -->
    <div class="highlights">
      {% if section.settings.express %}
        <p class="highlights--express">Expressversand</p>
      {% endif %}
      {% if section.settings.discountOffer %}
        <p class="highlights--discount">Sonderangebot</p>
      {% endif %}
    </div>

    {% render 'product-info'
      , rating_stars: section.settings.rating_stars 
      , feedbackNo: section.settings.feedbackNo
      , show_artNo: section.settings.show_artNo
      , artNo: section.settings.artNo
      , show-favorite: section.settings.show-favorite 
      , offensive_title: section.settings.bold-title
      , show_brand: section.settings.show_brand-logo
    %}
    <!-- Extra Info - Metainfo -->
    <p class="description">
      {{ section.settings.prodDescription }}
    </p>

    {% render 'product-options'
      , rating_stars: section.settings.show-variations
    %}

    {% render 'product-price'
      , rating_stars: section.settings.show_energy_label
    %}


    <!-- Cart Actions -->
    <div class="cart-action">
      <form action="" method="post">
        <div class="product-counter">
          <button type="button" class="product-counter--decrease">
            <img
              src="{{ 'icon-minus.svg' | asset_url }}"
              alt="Decrease"
              width="24"
              height="24">
          </button>
          <span class="product-counter--cart">{{ section.settings.quantity }}</span>
          <button type="button" class="product-counter--increase">
            <img
              src="{{ 'icon-plus.svg' | asset_url }}"
              alt="Increase"
              width="24"
              height="24">
          </button>
        </div>
        <button type="submit" class="cart-action--submit">
          <img
            src="{{ 'icon-cart.svg' | asset_url }}"
            alt="Cart"
            width="24"
            height="24">
          <span>In den Warenkorb</span>
        </button>
        <button type="button" class="cart-action--wishlist">
          <img
            src="{{ 'icon-heart.svg' | asset_url }}"
            alt="Wishlist"
            width="24"
            height="24">
        </button>
      </form>
    </div>

    <!-- Delivery and Retour -->
    <div class="delivery-retour">
      <p class="delivery-retour--text"></p>
      <div class="deliver-time">
        <img
          src="{{ 'icon-tick.svg' | asset_url }}"
          alt="Wishlist"
          width="24"
          height="24">
        <p>Lieferbar in 3 Tagen</p>
        <img
          src="{{ 'icon-arrow.svg' | asset_url }}"
          alt="Wishlist"
          width="24"
          height="24">
      </div>
      <div class="deliver-cost">
        <img
          src="{{ 'icon-truck.svg' | asset_url }}"
          alt="Wishlist"
          width="24"
          height="24">
        <p>Kostenloser Versand</p>
        <img
          src="{{ 'icon-arrow.svg' | asset_url }}"
          alt="Wishlist"
          width="24"
          height="24">
      </div>
      <div class="deliver-time">
        <img
          src="{{ 'icon-return.svg' | asset_url }}"
          alt="Wishlist"
          width="24"
          height="24">
        <p>14 Tage Rückgabeservice</p>
        <img
          src="{{ 'icon-arrow.svg' | asset_url }}"
          alt="Wishlist"
          width="24"
          height="24">
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Product Details",
    "blocks": [],
    "presets": [
      {
        "name": "Product Details"
      }
    ],
    "settings": [
      {
        "type": "checkbox",
        "id": "discountOffer",
        "label": "Enable Discount Display",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "express",
        "label": "Enable Express Delivery",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "orientation",
        "label": "Horizontal Image Orientation",
        "default": false
      },
      {
        "type": "text",
        "id": "rating_stars",
        "label": "Rating Stars",
        "default": "5"
      },
      {
        "type": "text",
        "id": "feedbackNo",
        "label": "Number of Feedbacks",
        "default": "44"
      },
      {
        "type": "checkbox",
        "id": "show_artNo",
        "label": "Show Article Number",
        "default": true
      },
      {
        "type": "text",
        "id": "artNo",
        "label": "Article Number",
        "default": "12345"
      },
      {
        "type": "checkbox",
        "id": "show-favorite",
        "label": "Show Favorite Icon",
        "default": true
      },
      {
        "type": "text",
        "id": "titel",
        "label": "Product Title",
        "default": "Default Product Name"
      },
      {
        "type": "checkbox",
        "id": "bold-title",
        "label": "Use H5 for Product Title",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_brand-logo",
        "label": "Show Brand Logo",
        "default": true
      },
      {
        "type": "textarea",
        "id": "prodDescription",
        "label": "Product Description",
        "default": "Default description for the product."
      },
      {
        "type": "checkbox",
        "id": "show-variations",
        "label": "Product Variations",
        "default": true
      },
      {
        "type": "number",
        "id": "quantity",
        "label": "Default Quantity",
        "default": 1
      },
      {
        "type": "checkbox",
        "id": "show_energy_label",
        "label": "Show Energy Label",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "energy_label",
        "label": "Energy Label Image"
      },
      {
        "type": "text",
        "id": "energy_label_text",
        "label": "Energy Efficency Label",
        "default": "Produktdatenblatt"
      }
    ]
  }
{% endschema %}

