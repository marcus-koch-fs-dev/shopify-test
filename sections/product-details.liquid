<link rel="stylesheet" href="{{ 'product-details.css' | asset_url }}">
<script src="{{ 'product-details.js' | asset_url }}" defer="defer"></script>

<section class="product-details">
  <!-- Left Section -->
  {% render 'product-gallery' %}

  <!-- Right Section -->
  <div class="user-action">
    <div class="buybox">
      {% render 'product-highlights'
        , discountOffer: section.settings.discountOffer
        , express: section.settings.express
      %}

      {% render 'product-info'
        , rating_stars: section.settings.rating_stars 
        , feedbackNo: section.settings.feedbackNo
        , show_artNo: section.settings.show_artNo
        , artNo: section.settings.artNo
        , show-favorite: section.settings.show-favorite 
        , offensive_title: section.settings.bold-title
        , show_brand: section.settings.show_brand-logo
      %}
      {% render 'product-description' %}

      {% render 'product-options'
        , rating_stars: section.settings.show-variations
      %}

      {% render 'product-price'
        , rating_stars: section.settings.show_energy_label
      %}

      {% render 'product-cart'
        , out-of-stock: section.settings.out-of-stock %}

      {% render 'product-transport'
        , express: section.settings.express
        , out-of-stock: section.settings.out-of-stock %}

    </div>
    {% render 'payments' %}

  </div>
</section>

{% schema %}
  {
    "name": "Product Details",
    "blocks": [],
    "presets": [
      {
        "name": "Product Details"
      }
    ],
    "settings": [
      {
        "type": "checkbox",
        "id": "discountOffer",
        "label": "Enable Discount Display",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "express",
        "label": "Enable Express Delivery",
        "default": true
      },
      {
        "type": "text",
        "id": "rating_stars",
        "label": "Rating Stars",
        "default": "5"
      },
      {
        "type": "text",
        "id": "feedbackNo",
        "label": "Number of Feedbacks",
        "default": "44"
      },
      {
        "type": "checkbox",
        "id": "show_artNo",
        "label": "Show Article Number",
        "default": true
      },
      {
        "type": "text",
        "id": "artNo",
        "label": "Article Number",
        "default": "12345"
      },
      {
        "type": "checkbox",
        "id": "show-favorite",
        "label": "Show Favorite Icon",
        "default": true
      },
      {
        "type": "text",
        "id": "titel",
        "label": "Product Title",
        "default": "Default Product Name"
      },
      {
        "type": "checkbox",
        "id": "bold-title",
        "label": "Use H5 for Product Title",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_brand-logo",
        "label": "Show Brand Logo",
        "default": true
      },
      {
        "type": "textarea",
        "id": "prodDescription",
        "label": "Product Description",
        "default": "Default description for the product."
      },
      {
        "type": "checkbox",
        "id": "show-variations",
        "label": "Product Variations",
        "default": true
      },
      {
        "type": "number",
        "id": "quantity",
        "label": "Default Quantity",
        "default": 1
      },
      {
        "type": "checkbox",
        "id": "show_energy_label",
        "label": "Show Energy Label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "out-of-stock",
        "label": "Product is out of stock",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "energy_label",
        "label": "Energy Label Image"
      },
      {
        "type": "text",
        "id": "energy_label_text",
        "label": "Energy Efficency Label",
        "default": "Produktdatenblatt"
      }
    ]
  }
{% endschema %}